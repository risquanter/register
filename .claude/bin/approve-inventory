#!/usr/bin/env bash
# Add files to a plan's file inventory and point the approval token at that
# plan. Run by the user, from the user's own terminal, never by the agent.
#
# The file inventory is the list the approval hook reads to decide whether a
# gated edit is permitted. It lives in its own document beside the plan
# (PLAN-<name>-INVENTORY.md), which the hook denies the agent from writing, so
# the agent can propose an amendment but cannot apply one.
#
# Input is a plain text file, .claude/protocol/pending:
#
#     docs/dev/plans/PLAN-CACHE-REGISTRY-RENAME.md
#     modules/server/src/main/scala/com/risquanter/register/cache/Registry.scala
#     new: modules/server/src/main/scala/com/risquanter/register/cache/Keys.scala
#
# The first line names the plan. Every line after it is one repo-relative path
# to authorize.
#
# A path must already exist in the working tree, which catches a mistyped one.
# A file the plan is going to CREATE cannot pass that check, so it carries the
# marker "new:". The marker is the agent stating that the file does not exist
# yet; the user reads that claim in the block before running this script, and
# that reading is what authorizes it. An unmarked path that does not exist is
# rejected as a typo.
#
# A "#" begins a comment anywhere in a line, and blank lines are ignored.
#
# Usage:
#   .claude/bin/approve-inventory            amend, then approve
#   .claude/bin/approve-inventory amend      add the paths to the inventory
#   .claude/bin/approve-inventory approve    point the token at the plan
#   .claude/bin/approve-inventory --dry-run  report what would change
#
# The token names one plan. Approving a plan replaces whatever was approved
# before, and the script prints what it removed.
#
# "amend" leaves the pending file in place so "approve" can read it next;
# "approve" and the no-argument form consume it.
#
# The script requires a terminal on both stdin and stdout. That catches an
# accidental non-interactive invocation. It does NOT prove a person is present:
# a pseudo-terminal satisfies the same test, and allocating one is ordinary.
# The control that actually keeps the agent out of this script is the hook's
# refusal of any command naming .claude/bin, backed by the standing rule that
# the agent never works around a control and escalates instead.
set -euo pipefail

# Whether a path is already listed must be decided by the SAME rule the hook
# uses to authorize it, or this script reports a path as covered that the hook
# will go on to deny. Both match a whole whitespace-delimited token on a bullet
# line, not a substring of one.
already_listed() {
  [ -f "$1" ] || return 1
  awk -v want="$2" '
    /^[[:space:]]*- / {
      line = $0
      sub(/^[[:space:]]*-[[:space:]]+/, "", line)
      n = split(line, parts, /[[:space:]]+/)
      for (i = 1; i <= n; i++) {
        p = parts[i]
        gsub(/^[`("*]+/, "", p)
        gsub(/[`)"*,;:.]+$/, "", p)
        if (p == want) { found = 1; exit }
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$1"
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

PENDING=".claude/protocol/pending"
TOKEN=".claude/protocol/approved"

MODE="both"
DRY=0
for arg in "$@"; do
  case "$arg" in
    amend|approve|both) MODE="$arg" ;;
    --dry-run) DRY=1 ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if [ ! -t 0 ] || [ ! -t 1 ]; then
  echo "refusing to run: this script requires an interactive terminal." >&2
  echo "It authorizes source edits, so it runs only where a person is typing." >&2
  exit 3
fi

[ -f "$PENDING" ] || { echo "no $PENDING — nothing to apply." >&2; exit 1; }

# --- read and validate the pending file -------------------------------------
PLAN=""
PATHS=()
IS_NEW=()
while IFS= read -r LINE || [ -n "$LINE" ]; do
  LINE="${LINE%%#*}"
  LINE="${LINE#"${LINE%%[![:space:]]*}"}"
  LINE="${LINE%"${LINE##*[![:space:]]}"}"
  [ -n "$LINE" ] || continue
  if [ -z "$PLAN" ]; then
    PLAN="$LINE"
    continue
  fi
  case "$LINE" in
    new:*)
      LINE="${LINE#new:}"
      LINE="${LINE#"${LINE%%[![:space:]]*}"}"
      PATHS+=("$LINE"); IS_NEW+=(1)
      ;;
    *)
      PATHS+=("$LINE"); IS_NEW+=(0)
      ;;
  esac
done < "$PENDING"

ERRORS=0
fail() { echo "  error: $1" >&2; ERRORS=$((ERRORS + 1)); }

[ -n "$PLAN" ] || { echo "the pending file names no plan." >&2; exit 1; }
case "$PLAN" in
  /*) fail "the plan path must be repo-relative, not absolute: $PLAN" ;;
  *-INVENTORY.md) fail "name the plan, not its inventory document: $PLAN" ;;
  docs/dev/plans/PLAN-*.md) [ -f "$PLAN" ] || fail "no such plan: $PLAN" ;;
  *) fail "not a plan document under docs/dev/plans/: $PLAN" ;;
esac

SIDECAR="${PLAN%.md}-INVENTORY.md"

i=0
while [ "$i" -lt "${#PATHS[@]}" ]; do
  p="${PATHS[$i]}"
  n="${IS_NEW[$i]}"
  i=$((i + 1))
  [ -n "$p" ] || { fail "empty path after the 'new:' marker"; continue; }
  case "$p" in
    /*) fail "absolute path (must be repo-relative): $p"; continue ;;
    *-INVENTORY.md) fail "an inventory file cannot authorize itself: $p"; continue ;;
    .claude/*) fail "the protocol machinery is never authorized for editing: $p"; continue ;;
  esac
  if [ "$n" -eq 1 ]; then
    [ -e "$p" ] && echo "  note: marked new but already exists: $p"
  else
    [ -e "$p" ] || fail "no such file in the working tree: $p
         If the plan creates this file, mark the line 'new: $p'."
  fi
done

[ "$ERRORS" -eq 0 ] || { echo "" >&2; echo "$ERRORS problem(s); nothing written." >&2; exit 1; }

# --- amend -------------------------------------------------------------------
if [ "$MODE" = "amend" ] || [ "$MODE" = "both" ]; then
  NEW=()
  for p in "${PATHS[@]}"; do
    if already_listed "$SIDECAR" "$p"; then
      echo "  already listed: $p"
    else
      NEW+=("$p")
    fi
  done

  if [ "${#NEW[@]}" -eq 0 ]; then
    echo "inventory already covers every path; nothing to add."
  elif [ "$DRY" -eq 1 ]; then
    echo "would add to $SIDECAR:"
    for p in "${NEW[@]}"; do echo "  - $p"; done
  else
    if [ ! -f "$SIDECAR" ]; then
      {
        printf '# File inventory — %s\n\n' "$(basename "$PLAN")"
        printf 'The approval hook reads this file to decide whether a gated edit is\n'
        printf 'permitted. A gated edit is allowed only when the edited file appears on a\n'
        printf 'bullet line below, written as a full repo-relative path. Text that is not a\n'
        printf 'bullet line authorizes nothing.\n\n'
        printf 'Only the user writes this file, through `.claude/bin/approve-inventory`.\n\n'
      } > "$SIDECAR"
    fi
    if [ -n "$(tail -c 1 "$SIDECAR")" ]; then
      printf '\n' >> "$SIDECAR"
    fi
    for p in "${NEW[@]}"; do
      printf -- '- %s\n' "$p" >> "$SIDECAR"
      echo "  added: $p"
    done
    echo "$SIDECAR updated."
  fi
fi

# --- approve -----------------------------------------------------------------
# The token names one plan. Approving replaces what was there, and every plan
# dropped is named, so a revoked approval is never silent.
if [ "$MODE" = "approve" ] || [ "$MODE" = "both" ]; then
  DROPPED=""
  if [ -f "$TOKEN" ]; then
    while IFS= read -r OLD || [ -n "$OLD" ]; do
      OLD="${OLD%%#*}"
      OLD="$(echo "$OLD" | xargs 2>/dev/null || true)"
      [ -n "$OLD" ] || continue
      [ "$OLD" = "$PLAN" ] && continue
      DROPPED="$DROPPED
  no longer approved: $OLD"
    done < "$TOKEN"
  fi

  if [ "$DRY" -eq 1 ]; then
    echo "would point the token at: $PLAN${DROPPED}"
  else
    mkdir -p .claude/protocol
    printf '%s\n' "$PLAN" > "$TOKEN"
    echo "token now approves: $PLAN${DROPPED}"
  fi
fi

# The pending file is the input to both phases, so "amend" leaves it for a
# following "approve" to read. Only a run that reaches the approve phase
# consumes it.
if [ "$DRY" -eq 0 ] && { [ "$MODE" = "approve" ] || [ "$MODE" = "both" ]; }; then
  rm -f "$PENDING"
fi

echo ""
echo "Review the change before committing:  git diff -- $SIDECAR"
