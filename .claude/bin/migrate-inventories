#!/usr/bin/env bash
# One-time migration: move each plan's "## File inventory" section body into a
# sidecar document named after the plan, and leave a pointer in the plan.
#
# Correctness check: the bullet lines the approval hook extracts must be byte
# identical before (from the plan) and after (from the sidecar). The script
# writes nothing for a plan that fails that check, and stops.
#
# Usage:
#   bash .claude/bin/migrate-inventories --dry-run   report, change nothing
#   bash .claude/bin/migrate-inventories             apply
#
# Delete this script once the migration has landed.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

bullets_of() { awk '/^## File inventory/{f=1;next} /^## /{f=0} f && /^[[:space:]]*- /' "$1"; }

DRY="${1:-}"

for PLAN in docs/dev/plans/PLAN-*.md; do
  grep -q '^## File inventory' "$PLAN" || continue
  SIDECAR="${PLAN%.md}-INVENTORY.md"
  BASE="$(basename "$PLAN")"

  START=$(grep -n '^## File inventory' "$PLAN" | head -1 | cut -d: -f1)
  TOTAL=$(wc -l < "$PLAN")
  END=$(awk -v s="$START" 'NR>s && /^## /{print NR; exit}' "$PLAN")
  [ -n "$END" ] || END=$((TOTAL + 1))

  # Body: everything strictly between the heading and the next "## " heading.
  BODY_FILE=$(mktemp)
  sed -n "$((START + 1)),$((END - 1))p" "$PLAN" > "$BODY_FILE"

  # Trailing blank lines and a horizontal rule belong to the plan's own
  # structure, not to the inventory; count them so the plan keeps them.
  TAIL_KEEP=0
  while true; do
    LAST=$(tail -n 1 "$BODY_FILE" 2>/dev/null || true)
    LINES=$(wc -l < "$BODY_FILE")
    [ "$LINES" -gt 0 ] || break
    case "$LAST" in
      ""|"---") sed -i '$d' "$BODY_FILE"; TAIL_KEEP=$((TAIL_KEEP + 1)) ;;
      *) break ;;
    esac
  done

  NEW_SIDECAR=$(mktemp)
  {
    printf '# File inventory — %s\n\n' "$BASE"
    printf 'The approval hook reads this file to decide whether a gated edit is\n'
    printf 'permitted. A gated edit is allowed only when the edited file appears on a\n'
    printf 'bullet line below, written as a full repo-relative path. Text that is not a\n'
    printf 'bullet line authorizes nothing.\n\n'
    printf 'Only the user writes this file, through `.claude/bin/approve-inventory`.\n\n'
    cat "$BODY_FILE"
  } > "$NEW_SIDECAR"

  BEFORE=$(bullets_of "$PLAN")
  AFTER=$(awk '/^[[:space:]]*- /' "$NEW_SIDECAR")
  if [ "$BEFORE" != "$AFTER" ]; then
    echo "REFUSED $BASE — bullet set differs between plan and sidecar" >&2
    diff <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER") >&2 || true
    rm -f "$BODY_FILE" "$NEW_SIDECAR"
    exit 1
  fi

  N=$(printf '%s\n' "$BEFORE" | grep -c '^[[:space:]]*- ' || true)
  printf '%-42s bullets=%-4s -> %s\n' "$BASE" "$N" "$(basename "$SIDECAR")"

  if [ "$DRY" = "--dry-run" ]; then rm -f "$BODY_FILE" "$NEW_SIDECAR"; continue; fi

  cp "$NEW_SIDECAR" "$SIDECAR"

  NEW_PLAN=$(mktemp)
  {
    sed -n "1,${START}p" "$PLAN"
    printf '\n'
    printf 'The file inventory lives in its own document, `%s`,\n' "$(basename "$SIDECAR")"
    printf 'which the approval hook reads and only the user writes.\n'
    sed -n "$((END - TAIL_KEEP)),$((END - 1))p" "$PLAN"
    sed -n "${END},\$p" "$PLAN"
  } > "$NEW_PLAN"
  cp "$NEW_PLAN" "$PLAN"

  rm -f "$BODY_FILE" "$NEW_SIDECAR" "$NEW_PLAN"
done
echo "done"
